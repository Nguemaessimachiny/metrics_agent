# =============================================================================
# PARTIE 2 — Fichier de configuration (.env)
# =============================================================================
# Ce fichier est un MODÈLE (.env.example).
# Pour l'utiliser :
#   Linux/macOS : cp .env.example .env
#   Windows     : Copy-Item .env.example .env
#
# Le vrai fichier .env n'est JAMAIS commité (voir .gitignore).
# Docker Compose le charge via "env_file: .env".
# =============================================================================

# ---------------------------------------------------------------------------
# METRICS_ENDPOINT
# ---------------------------------------------------------------------------
# URL où l'agent envoie les métriques (POST).
#
# - En local (python -m app.agent, hors Docker) :
#     http://127.0.0.1:8000/metrics
#
# - Avec Docker Compose :
#     le service "agent" IGNORE cette valeur et utilise à la place
#     http://api:8000/metrics  (défini dans docker-compose.yaml)
#     car entre conteneurs on parle via le nom du service, pas 127.0.0.1
# ---------------------------------------------------------------------------
METRICS_ENDPOINT=http://127.0.0.1:8000/metrics

# ---------------------------------------------------------------------------
# COLLECTION_INTERVAL
# ---------------------------------------------------------------------------
# Nombre de secondes entre deux collectes de métriques par l'agent.
# Exemple : 5 → l'agent envoie une métrique toutes les 5 secondes.
# ---------------------------------------------------------------------------
COLLECTION_INTERVAL=5

# ---------------------------------------------------------------------------
# REQUEST_TIMEOUT
# ---------------------------------------------------------------------------
# Délai max (en secondes) pour chaque requête HTTP de l'agent vers l'API.
# Si l'API ne répond pas à temps → erreur de timeout gérée par le code.
# ---------------------------------------------------------------------------
REQUEST_TIMEOUT=5
